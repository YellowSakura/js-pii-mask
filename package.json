{
  "name": "@yellowsakura/js-pii-mask",
  "version": "0.9.2",
  "description": "Simple and effective PII data masking library for TypeScript/JavaScript",
  "keywords": [
    "pii",
    "mask",
    "masking",
    "data-privacy",
    "privacy",
    "anonymization",
    "personal-data"
  ],
  "homepage": "https://github.com/YellowSakura/js-pii-mask#readme",
  "bugs": {
    "url": "https://github.com/YellowSakura/js-pii-mask/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YellowSakura/js-pii-mask.git"
  },
  "license": "MIT",
  "author": "Yellow Sakura",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "quality": "eslint src *.ts",
    "test": "jest",
    "test:single": "jest -t"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "jest": "^30.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "module": "./dist/index.mjs",
  "dependencies": {
    "compromise": "^14.17.0"
  }
}
